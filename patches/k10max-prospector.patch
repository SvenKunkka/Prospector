diff --git a/keyboards/keychron/k10_max/mcuconf.h b/keyboards/keychron/k10_max/mcuconf.h
index 9a2b660..1ab22ad 100644
--- a/keyboards/keychron/k10_max/mcuconf.h
+++ b/keyboards/keychron/k10_max/mcuconf.h
@@ -35,3 +35,12 @@
 
